{
  "id": "com.videomanual.editor-assistant",
  "name": "編集アシスタント（マニュアル準拠）",
  "version": "1.0.0",
  "main": "index.html",
  "manifestVersion": 6,
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "videomanual.assistant",
      "label": {
        "default": "編集アシスタント"
      },
      "minimumSize": {
        "width": 300,
        "height": 320
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 640
      },
      "preferredFloatingSize": {
        "width": 480,
        "height": 760
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "allowCodeGenerationFromStrings": false,
    "clipboard": "readAndWrite"
  }
}
